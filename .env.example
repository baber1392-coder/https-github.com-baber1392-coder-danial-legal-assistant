# Public Supabase settings. Never place a service_role or secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://jwhyeohqolabcbuwhfon.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SB_PUBLISHABLE_KEY

# Preferred server-side provider: Groq OpenAI-compatible API.
# Create a key in https://console.groq.com/keys and store it only in Render Environment.
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
# Optional; default: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Optional legacy fallback: Google Gemini.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Optional paid fallback; used only when GEMINI_API_KEY is not configured.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-6-astra
