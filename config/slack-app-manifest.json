{
  "display_information": {
    "name": "دستیار جامع اختصاصی دانیال",
    "description": "گزارش‌گیری امن از کانال‌های Slack و استخراج تصمیمات و اقدامات",
    "background_color": "#263447"
  },
  "features": {
